<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:maxHeight="600dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_settings_semi_transparent">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/settings_title"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/darker_gray" />

        <!-- Кнопка с информацией о пользователе -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUserInfo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical"
            android:padding="16dp"
            android:text="@string/settings_user_guest"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_expand_more"
            app:iconGravity="end"
            app:iconTint="@color/primary" />

        <!-- Выпадающее меню для информации о пользователе -->
        <LinearLayout
            android:id="@+id/layoutUserDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_settings_item"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvUserInfoDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="@string/settings_user_guest_name"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvUserAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="@string/settings_user_guest_age"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvUserModeDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="@string/settings_user_mode"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Кнопка со статистикой -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStats"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical"
            android:padding="16dp"
            android:text="@string/settings_stats_title"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_expand_more"
            app:iconGravity="end"
            app:iconTint="@color/primary" />

        <!-- Выпадающее меню со статистикой -->
        <LinearLayout
            android:id="@+id/layoutStatsDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_settings_item"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Количество выполненных заданий -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_stats_tasks"
                    android:textColor="@android:color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTasksCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Прогресс заданий -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Прогресс заданий:"
                    android:textColor="@android:color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTasksProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Осталось 0 из 0"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Кнопка сброса статистики -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearStats"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_stats_clear"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Кнопка "Язык" (НОВАЯ) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLanguage"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="start|center_vertical"
            android:padding="16dp"
            android:text="@string/settings_language"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_language"
            app:iconGravity="textStart"
            app:iconTint="@color/primary" />

        <!-- Кнопка "О приложении" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="start|center_vertical"
            android:padding="16dp"
            android:text="@string/settings_about"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_info"
            app:iconGravity="textStart" />

        <!-- Кнопка "Поддержать проект" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonat"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="start|center_vertical"
            android:padding="16dp"
            android:text="@string/donat"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@android:color/darker_gray" />

        <!-- Кнопка выхода -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/primary_dark"
            android:text="@string/settings_logout"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart" />

    </LinearLayout>
</ScrollView>